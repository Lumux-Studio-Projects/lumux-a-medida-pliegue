---
interface Props {
  name: string;
  category: string;
  collection: string;
  image: string;
  dimensions: string;
  slug: string;
}

const {
  name,
  category,
  collection,
  image,
  dimensions,
  slug
} = Astro.props;
---

<article class="product-card photo-reveal">
  <a href={`/catalogo/${slug}`} class="product-link-media" aria-label={`Ver ficha de ${name}`}>
    <div class="product-frame">
      <img src={image} alt={name} loading="lazy" class="product-thumb" />

    </div>
  </a>

  <div class="product-details">
    <div class="product-meta-row">
      <span class="product-category">{category}</span>
      <span class="product-dim">{dimensions.split('·')[0]}</span>
    </div>

    <h3 class="product-name">
      <a href={`/catalogo/${slug}`}>{name}</a>
    </h3>

    <div class="product-bottom-link">
      <span class="product-collection">{collection === 'coleccion-luz' ? 'Colección Luz' : collection === 'coleccion-tierra' ? 'Colección Tierra' : collection}</span>
      <a href={`/catalogo/${slug}`} class="view-item-a" aria-label={`Consultar ${name}`}>Ver pieza ↗</a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
  }

  .product-link-media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background-color: var(--color-bg-secondary);
    border: 0;
  }

  .product-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .product-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-link-media:hover .product-thumb {
    transform: scale(1.04);
  }

  .product-details {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .product-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 0;
    padding-bottom: 0.35rem;
  }

  .product-dim {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .product-name {
    font-size: 1.35rem;
    line-height: 1.3;
    min-height: 0;
    color: var(--color-text-primary);
    margin-top: 0.2rem;
  }

  .product-name a {
    transition: color 0.15s ease;
  }

  .product-name a:hover {
    color: var(--color-accent);
  }

  .product-category {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .product-collection {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .product-link-media:focus-visible, .product-name a:focus-visible, .view-item-a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .product-bottom-link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .view-item-a {
    font-size: 0.8125rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
</style>
