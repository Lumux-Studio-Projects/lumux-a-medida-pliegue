---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

const collections = await getCollection('collections');
const allProducts = await getCollection('products');
---

<BaseLayout 
  title="Colecciones" 
  description="Líneas de diseño de Atelier Pliegue: Colección Luz (iluminación de autor) y Colección Tierra (mobiliario de madera y gres)."
>
  <div class="page-header">
    <div class="container">
      <span class="tag-meta">Series Temáticas</span>
      <h1 class="header-h1">COLECCIONES DE AUTOR</h1>
      <p class="header-lead">
        Organizamos nuestras piezas en dos universos materiales: la ligereza reflectante de la luz y la gravedad táctil de la tierra.
      </p>
    </div>
  </div>

  <section class="collections-detail-section">
    <div class="container">
      {collections.map((col, index) => {
        const colProducts = allProducts.filter(p => p.data.collection === col.id);
        return (
          <article class:list={['collection-block', { 'alt-order': index % 2 !== 0 }]}>
            <div class="collection-intro-grid">
              <div class="col-text">
                <span class="tag-meta">Serie 0{index + 1}</span>
                <h2 class="col-title">{col.data.title}</h2>
                <p class="col-subtitle">{col.data.subtitle}</p>
                <p class="col-desc">{col.data.description}</p>
                <a href={`/catalogo?coleccion=${col.id}`} class="btn btn-secondary">
                  Ver piezas de {col.data.title} ({colProducts.length}) →
                </a>
              </div>

              <div class="col-hero-media">
                <img src={col.data.coverImage} alt={col.data.title} class="col-hero-img" />
              </div>
            </div>

            <!-- Muestra de piezas de esta colección -->
            <div class="col-products-preview">
              <h3 class="preview-heading">Piezas destacadas de {col.data.title}:</h3>
              <div class="preview-grid">
                {colProducts.slice(0, 3).map(p => (
                  <ProductCard 
                    name={p.data.name}
                    category={p.data.category}
                    collection={p.data.collection}
                    image={p.data.images[0].src}
                    dimensions={p.data.dimensions}
                    slug={p.id}
                  />
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: clamp(3.5rem, 6vw, 6rem) 0 3.5rem;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
  }

  .header-h1 {
    margin: 0.75rem 0 1rem;
  }

  .header-lead {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    max-width: 650px;
    line-height: 1.6;
  }

  .collections-detail-section {
    padding: clamp(4rem, 8vw, 8rem) 0;
  }

  .collection-block {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-bottom: 6rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 6rem;
  }

  .collection-block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .collection-intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .collection-intro-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 5rem;
    }

    .alt-order .collection-intro-grid {
      grid-template-columns: 1.2fr 1fr;
    }

    .alt-order .col-text {
      order: 2;
    }

    .alt-order .col-hero-media {
      order: 1;
    }
  }

  .col-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 0.5rem 0 0.5rem;
  }

  .col-subtitle {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .col-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .col-hero-media {
    border-radius: var(--radius-xs);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border);
  }

  .col-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Previews */
  .col-products-preview {
    border-top: 1px solid var(--color-border-light);
    padding-top: 2.5rem;
  }

  .preview-heading {
    font-size: 1.15rem;
    margin-bottom: 2rem;
    color: var(--color-text-primary);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .preview-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
